# Fuel Wallet Frontend Environment Configuration
# Public Clerk Publishable Key (safe for browser exposure; NEVER put CLERK_SECRET_KEY here)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Backend API Base URL (defaults to http://localhost:3000/api; Vite dev proxy routes /api -> http://localhost:3000)
VITE_API_URL=http://localhost:3000/api

